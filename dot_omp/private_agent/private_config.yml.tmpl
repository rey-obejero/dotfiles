modelRoles:
  default: "{{ .omp_model_default }}"
  slow: "{{ .omp_model_slow }}"
  smol: "{{ .omp_model_smol }}"
cycleOrder:
  - default
  - slow
  - smol
prewalk:
  enabled: false
advisor:
  enabled: false
title:
  icons: nf+emoji
completion:
  notify: off
error:
  notify: off
ask:
  notify: off
memory:
  backend: mnemopi
retry:
  fallbackChains:
    default:{{ if .omp_default_model_fallback }} ["{{ .omp_default_model_fallback }}"]{{ else }} []{{ end }}
    slow:{{ if .omp_slow_model_fallback }} ["{{ .omp_slow_model_fallback }}"]{{ else }} []{{ end }}
    smol:{{ if .omp_smol_model_fallback }} ["{{ .omp_smol_model_fallback }}"]{{ else }} []{{ end }}
symbolPreset: nerd
composer:
  shape: pi
  tokenRate: true
theme:
  light: moondust
  dark: moondust
setupVersion: 3
statusLine:
  preset: custom
  leftSegments: []
  rightSegments: []
  sessionAccent: true
  transparent: false
  separator: none
tui:
  tight: false
  vimMode: true
  vimModeDisplay: text
colorBlindMode: false
hideThinkingBlock: false
personality: friendly
tools:
  approvalMode: write
display:
  showTokenUsage: true
secrets:
  enabled: true
compaction:
  thresholdPercent: 70
update:
  auto: false
