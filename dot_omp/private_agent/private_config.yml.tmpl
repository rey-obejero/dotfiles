modelRoles:
  default: "{{ .omp_model_default }}"
  slow: "{{ .omp_model_slow }}"
cycleOrder:
  - default
  - slow
prewalk:
  enabled: false
advisor:
  enabled: false
title:
  icons: nf+emoji
completion:
  notify: off
error:
  notify: off
ask:
  notify: off
memory:
  backend: mnemopi
retry:
  fallbackChains:
    default:
      - "{{ .omp_default_model_fallback }}"
    slow:
      - "{{ .omp_slow_model_fallback }}"
symbolPreset: nerd
composer:
  shape: pi
  tokenRate: true
theme:
  light: moondust
  dark: github-base16
setupVersion: 3
statusLine:
  preset: custom
  leftSegments: []
  rightSegments: []
  sessionAccent: true
  transparent: false
  separator: none
tui:
  tight: false
  vimMode: true
  vimModeDisplay: text
colorBlindMode: false
hideThinkingBlock: false
personality: friendly
tools:
  approvalMode: write
display:
  showTokenUsage: true
secrets:
  enabled: true
compaction:
  thresholdPercent: 70
update:
  auto: false