# ==============================================================================
# 1. System Paths & Environments
# ==============================================================================

# Zsh native path array injection
typeset -U path
path=("$HOME/.local/bin" "$HOME/bin" $path)
export PATH

# Bun global binaries. Oh My Pi (`omp`) installs here via `bun install -g`.
export BUN_INSTALL="$HOME/.bun"
path=("$BUN_INSTALL/bin" $path)
export PATH

export VISUAL=nvim
export EDITOR="$VISUAL"

# ==============================================================================
# 2. Oh My Zsh Configuration
# ==============================================================================
export ZSH="$HOME/.oh-my-zsh"

# Note: We leave ZSH_THEME blank or commented out because Starship will handle it below
# ZSH_THEME="robbyrussell"

plugins=(
  git
  sudo
  tmux
  fzf
  docker
  colored-man-pages
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# --- THE MISSING LINK: This actually starts Oh My Zsh ---
if [ -f "$ZSH/oh-my-zsh.sh" ]; then
  source $ZSH/oh-my-zsh.sh
fi

# ==============================================================================
# 3. Moondust colors
# ==============================================================================

# Terminal ANSI colors are remapped by WezTerm; these values choose the
# matching accents for command syntax, paths, errors, and suggestions.
export LS_COLORS='di=01;34:ln=01;36:so=01;35:pi=01;33:ex=01;32:bd=01;33:cd=01;33:su=01;31:sg=01;31:tw=01;31:ow=01;34:st=01;34:*.tar=01;31:*.tgz=01;31:*.zip=01;31:*.gz=01;31:*.bz2=01;31:*.xz=01;31:*.zst=01;31:*.7z=01;31:*.rar=01;31:*.jpg=01;35:*.png=01;35:*.mp4=01;35:*.mkv=01;35:*.pdf=01;35:*.md=01;34:*.json=01;34:*.yml=01;34:*.yaml=01;34:*.toml=01;34:*.lua=01;34:*.ts=01;34:*.js=01;34:*.rs=01;34:*.go=01;34'

ZSH_HIGHLIGHT_STYLES[comment]='fg=7'
ZSH_HIGHLIGHT_STYLES[command]='fg=0,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=0'
ZSH_HIGHLIGHT_STYLES[alias]='fg=0'
ZSH_HIGHLIGHT_STYLES[function]='fg=0'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=0'
ZSH_HIGHLIGHT_STYLES[path]='fg=8'
ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=8'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=3'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg=3'
ZSH_HIGHLIGHT_STYLES[string]='fg=6'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=8'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=1'
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# ==============================================================================
# 4. Prompt Configuration (Starship Hook)
# ==============================================================================
# Starship MUST be initialized AFTER Oh My Zsh, otherwise OMZ will break it
eval "$(starship init zsh)"

# ==============================================================================
# 4. Node Version Manager (NVM) Integration
# ==============================================================================
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use

# Lazy-load NVM completion for Zsh if installed
if [ -s "$NVM_DIR/zsh_completion" ]; then
    \. "$NVM_DIR/zsh_completion"
fi

# ==============================================================================
# 5. Standard Line Navigation & Keybindings (Emacs Style)
# ==============================================================================

# Force standard Emacs keybindings
bindkey -e

# Hand-map standard Ctrl modifier keys for seamless jumping:
bindkey '^[[1;5D' backward-word      # Ctrl + Left
bindkey '^[[1;5C' forward-word       # Ctrl + Right
bindkey '^H' backward-kill-word      # Ctrl + Backspace
bindkey '^?' backward-delete-char    # Fix backspace past initial prompt line

# --- Force Solid Block Cursor ---
function zle-line-init() {
    echo -ne "\e[2 q" 
}
zle -N zle-line-init

eval "$(zoxide init zsh)"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
