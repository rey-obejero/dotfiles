{
  "$schema": "https://opencode.ai/v2/cli.json",

  "theme": {
    "mode": "light",
    "name": "github"
  },
  "animations": true,
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": false,
    "permissions": "prompt"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.9999999999999999
  },
  "terminal": {
    "copy": "manual",
    "title": true
  },
  "prompt": {
    "image_preview": false
  },
  "tabs": {
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "scroll": {
    "speed": 3
  },
  "plugins": ["opencode-vim"]
}
