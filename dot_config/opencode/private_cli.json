{
  "$schema": "https://opencode.ai/v2/cli.json",

  // Terminal UI settings for OpenCode V2 (managed by chezmoi).
  "theme": {
    "mode": "light",                  // Pin light mode (override terminal auto-detect)
    "name": "github",
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": false,               // Hide the session scrollbar
    "thinking": "hide",               // Hide thinking blocks by default
    "image_preview": false,
    "permissions": "prompt",
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",                   // Word-wrap long diff lines
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.9999999999999999,
  },
  "terminal": {
    "copy": "manual",                 // Copy on explicit selection only
    "title": true,
  },
  "prompt": {
    "image_preview": false,
  },
  "tabs": {
    "layout": "horizontal",
    "indicators": "status",
  },
  "scroll": {
    "speed": 3,
  },
  "plugins": ["opencode-vim", "oc-tps"],
}
