{
  "$schema": "https://opencode.ai/config.json",

  "snapshots": false,

  "shell": "zsh", // Preferred terminal shell for command executions

  {{- $global := .opencode_model | default "deepseek/deepseek-flash" }}
  "model": "{{ $global }}", // Global default model fallback

  "default_agent": "plan", // New sessions start in the read-only plan agent

  // Only overrides that add something. The built-in sub-agents (general,
  // explore) are left untouched, so they keep their factory prompts,
  // descriptions, and policies. The old scout entry was not a built-in.
  "agents": {
    "plan": {
      "model": "{{ .opencode_model_plan | default $global }}",
    },

    "build": {
      "model": "{{ .opencode_model_build | default $global }}",
      "permissions": [
        { "action": "shell", "resource": "npm run build *", "effect": "allow" },
        { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
        { "action": "shell", "resource": "npm run test *", "effect": "allow" },
        {
          "action": "shell",
          "resource": "npm run typecheck *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "npm run format *",
          "effect": "allow",
        },
        { "action": "shell", "resource": "npm test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm build *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm lint *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
        {
          "action": "shell",
          "resource": "pnpm typecheck *",
          "effect": "allow",
        },
        { "action": "shell", "resource": "pnpm format *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm check *", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc *", "effect": "allow" },
        { "action": "shell", "resource": "npx vitest *", "effect": "allow" },
        { "action": "shell", "resource": "npx eslint *", "effect": "allow" },
        { "action": "shell", "resource": "npx prettier *", "effect": "allow" },
        { "action": "shell", "resource": "mvn test *", "effect": "allow" },
        { "action": "shell", "resource": "mvn compile *", "effect": "allow" },
        { "action": "shell", "resource": "mvn package *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet build *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet test *", "effect": "allow" },
        {
          "action": "shell",
          "resource": "dotnet restore *",
          "effect": "allow",
        },
        { "action": "shell", "resource": "dotnet format *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet ef *", "effect": "allow" },
      ],
    },
  },

  "formatter": true, // Automatically format modified files on write

  // Guardrails first, then the read-only allowlist. There is deliberately no
  // catch-all allow: the factory base policy stays intact, which preserves the
  // built-in .env read and external-directory asks.
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Safety locks.
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },

    // Read-only inspection, allowed without prompting.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "bash -n*", "effect": "allow" },
  ],

  // Active extensions and safety net plugins.
  // Command Code models/providers are supplied by the opencode-cmd-provider
  // plugin, so there is no hand-maintained "providers" block here.
  "plugins": ["cc-safety-net", "opencode-cmd-provider"],
}
