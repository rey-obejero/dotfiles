{
  "$schema": "https://opencode.ai/config.json",

  "shell": "zsh",                              // Preferred terminal shell for command executions

  {{- $global := .opencode_model | default "opencode/deepseek-v4-flash-free" }}
  "model": "{{ $global }}",                    // Global default model fallback

  // Agent roles setup
  "agent": {
    "plan": {                                  // Read-only agent
      "mode": "primary",
      "model": "{{ .opencode_model_plan | default $global }}",
      "permission": {
        "edit": "deny",                        // Prevents modifying code files during design
        "skill": "deny",                       // Restricts dynamic skill execution
        "todowrite": "deny",                   // Prevents writing tracking checklists
        "task": "deny",                        // Blocks sub-task management creation
        "bash": {                              // Enforces completely non-destructive planning
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "grep *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "ps *": "allow",
          "bash -n*": "allow",
          "caddy validate*": "allow",
        },
      },
    },

    "build": {                                 // High-throughput workhorse agent
      "mode": "primary",
      "model": "{{ .opencode_model_build | default $global }}",
      "permission": {
        "npm run build*": "allow",
        "npm run lint*": "allow",
        "npm run test*": "allow",
        "npm run typecheck*": "allow",
        "npm run format*": "allow",
        "npm run dev*": "allow",
        "npm test*": "allow",
        "pnpm build*": "allow",
        "pnpm lint*": "allow",
        "pnpm test*": "allow",
        "pnpm dev*": "allow",
        "pnpm typecheck*": "allow",
        "pnpm format*": "allow",
        "pnpm check*": "allow",
        "pnpm install*": "ask",
        "dotnet build*": "allow",
        "dotnet test*": "allow",
        "dotnet run*": "allow",
        "dotnet restore*": "allow",
        "dotnet format*": "allow",
        "dotnet watch*": "allow",
        "dotnet ef*": "allow",
        "mvn test*": "allow",
        "mvn compile*": "allow",
        "mvn clean*": "allow",
        "mvn package*": "allow",
        "npx tsc*": "allow",
        "npx vitest*": "allow",
        "npx playwright*": "allow",
        "npx eslint*": "allow",
        "npx prettier*": "allow",
        "pnpm exec *": "allow"
      },
    },

    "general": {                               // Versatile helper agent
      "mode": "subagent",
      "model": "{{ .opencode_model_general | default $global }}",
    },

    "explore": {                               // Fast discovery engine
      "mode": "subagent",
      "model": "{{ .opencode_model_explore | default $global }}",
    },

    "scout": {                                 // Reconnaissance agent
      "mode": "subagent",
      "model": "{{ .opencode_model_scout | default $global }}",
    },
  },

  "default_agent": "plan",                     // Forces new sessions to boot into the 'plan' agent

  "formatter": true,                           // Automatically format modified files on write

  "lsp": true,                                 // Enable LSP integrations for code intelligence

  // Tool-level and terminal permission boundaries
  "permission": {
    "*": "allow",

    "webfetch": "ask",                         // Blocks autonomous network page fetching

    "websearch": "ask",                        // Blocks live web searches to enforce local context usage
    "bash": {
      "*": "ask",                              // Prompts user permission for any unlisted terminal command

      "git status*": "allow",                  // Quick diagnostic: check repository changes

      "git diff*": "allow",                    // Quick diagnostic: view code modifications

      "git log*": "allow",                     // Quick diagnostic: check commit history

      "git commit*": "ask",                    // Prompts before automatic code commits

      "git push*": "ask",                      // Prompts before remote code pushing

      "git tag*": "ask",                       // Prompts before version tagging

      "git reset*": "deny",                    // Safety lock: prevents destructive state resets

      "git clean*": "deny",                    // Safety lock: prevents untracked file deletion

      "git stash*": "ask",

      "gh pr*": "ask",                         // Prompts before GitHub PR management

      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "ps *": "allow",
      "ss *": "allow",
      "sleep *": "allow",
      "seq *": "allow",
      "bash -n*": "allow",
      "echo *": "allow",
      "curl *": "allow",
    },
  },

  // Active extensions, context managers, and safety net plugins
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugin": [
    "@tarquinen/opencode-dcp@latest",          // Direct Context Protocol integration
    "cc-safety-net",                           // Extra safety rails for execution
    "envsitter-guard@latest",                  // Secrets and environment security guard
    "opencode-ignore",                         // Respects custom ignore patterns
    "@slkiser/opencode-quota",                 // Quota/token usage — run `npx @slkiser/opencode-quota init` once after apply (Node >= 22)
    "opencode-handoff",                        // Handoff prompt generator — `/handoff <goal>` (OpenCode >= v1.2.15)
  ],

  // OpenCode Quota: auto-detected provider declarations (added by init).
  "provider": {
    // Detected openrouter authentication; opencode-quota added this global provider declaration.
    "openrouter": {},
    // Detected opencode-go authentication; opencode-quota added this global provider declaration.
    "opencode-go": {},

